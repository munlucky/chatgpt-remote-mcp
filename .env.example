# ==============================================================================
# ChatGPT Remote MCP Server Environment Configuration Template
# Copy this file to .env and configure your personal settings.
# ==============================================================================

# 1. Host Workspace and User Directory Mapping
# SHARED_PATH: The primary workspace folder on your host machine (mounted to /shared in container)
SHARED_PATH=C:/workspace

# HOST_USER_HOME: (Optional) Your Windows user directory (mounted to /c/Users/your_username)
# e.g., C:/Users/your_username
HOST_USER_HOME=C:/Users/your_username

# 2. Public URL and Cloudflare Tunnel
# MCP_PUBLIC_URL: The HTTPS URL assigned to your Cloudflare Tunnel (e.g. https://mcp.yourdomain.com)
MCP_PUBLIC_URL=https://mcp.yourdomain.com

# CLOUDFLARE_TUNNEL_TOKEN: Tunnel token obtained from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# 3. OAuth 2.1 Security & Session Management
# MCP_OAUTH_ENABLED: Enable OAuth 2.1 PKCE for ChatGPT Actions/Connectors (default: true)
MCP_OAUTH_ENABLED=true

# MCP_OAUTH_APPROVAL_KEY: 32-byte secret key used to approve OAuth authorization requests.
# Generate a new secure 32-byte hex key using: openssl rand -hex 32
MCP_OAUTH_APPROVAL_KEY=your_generated_32byte_hex_secret_key_here

# MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS: Access token validity (default: 2592000 = 30 days)
# Setting this to 30 days prevents the frequent 1-hour session timeout prompt.
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=2592000

# MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS: Refresh token validity (default: 31536000 = 1 year)
# Allows ChatGPT to silently refresh tokens in the background without re-prompting.
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=31536000

# 4. Optional Configurations
TZ=Asia/Seoul
COKACREMOTE_REF=main
