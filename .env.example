# Copy to .env and replace placeholders. Never commit actual local settings.
SHARED_PATH=C:/path/to/workspace
WORKSPACE_ALIAS=/workspace
HOST_USER_HOME=C:/Users/your-username
HOST_HOME_ALIAS=/host/home
HOST_HOME_SECONDARY_ALIAS=/host/user
CODEX_PROFILE_PATH=C:/path/to/codex-profile
CODEX_PROFILE_TARGET=/opt/agent-profiles/codex
KERNEL_PROFILE_PATH=C:/path/to/kernel-profile
KERNEL_PROFILE_TARGET=/opt/agent-profiles/kernel

# Public endpoint and secrets
MCP_PUBLIC_URL=https://mcp.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token
MCP_OAUTH_ENABLED=true
MCP_OAUTH_APPROVAL_KEY=replace-with-a-random-secret
MCP_AUTH_TOKEN=
MCP_ALLOWED_HOSTS=
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_OAUTH_MAX_REGISTERED_CLIENTS=256

# Example names. For migrations, keep the existing volume names in .env.
COMPOSE_PROJECT_NAME=remote-mcp
MCP_CONTAINER_NAME=mcp-server
MCP_HOSTNAME=mcp-server
CLOUDFLARED_CONTAINER_NAME=mcp-tunnel
WORKMACHINE_IMAGE=chatgpt-remote-mcp:local
MCP_STATE_VOLUME=remote-mcp-state
MCP_STATE_DIR=/var/lib/chatgpt-remote-mcp
MCP_USAGE_VOLUME=remote-mcp-usage
MCP_HOME_VOLUME=remote-mcp-home
TZ=UTC

# Single-node process runtime budgets. Defaults are tuned for one user with many concurrent chats.
MCP_DEFAULT_OUTPUT_BYTES=131072
MCP_MAX_OUTPUT_BYTES=1048576
MCP_MAX_RETAINED_PROCESS_OUTPUT_BYTES=4194304
MCP_MAX_TOTAL_RETAINED_OUTPUT_BYTES=67108864
MCP_MAX_RUNNING_PROCESSES=12
MCP_MAX_PROCESSES=128
MCP_PROCESS_RETENTION_MS=3600000
MCP_DEFAULT_PROCESS_YIELD_MS=750
# read_process wait cap: 1000..300000 ms. Command timeout and initial yield are separate.
MCP_PROCESS_READ_WAIT_MAX_MS=60000

# Optional native host executor. Disabled by default.
# On Windows, scripts/start.ps1 starts the companion process when enabled.
# Container-to-host path mappings are derived from SHARED_PATH/HOST_USER_HOME by docker-compose.yml.
MCP_HOST_EXECUTOR_ENABLED=false
MCP_HOST_EXECUTOR_HEARTBEAT_MAX_AGE_MS=5000

# Independent Kernel reviewer; uses the native Codex app-server via companion.
# Requires a signed-in Codex installation and installed Kernel Host payload.
MCP_KERNEL_REVIEW_ENABLED=false
MCP_KERNEL_REVIEW_TARGET=host
MCP_KERNEL_REVIEW_CODEX=codex
MCP_KERNEL_REVIEW_TIMEOUT_MS=600000

# Ephemeral published artifacts. publish_file snapshots the source into a
# process-scoped temporary directory and exposes it through a short-lived URL.
MCP_ARTIFACT_TTL_SECONDS=600
MCP_ARTIFACT_MAX_BYTES=104857600
MCP_ARTIFACT_MAX_ACTIVE=64

# Durable task continuity state. Docker Compose stores this under MCP_STATE_DIR/continuity.
# Use required for GPT project work: reject exec_command/run_script without both IDs.
# File edits and stdin writes are not deduplicated by this setting.
MCP_EXECUTION_TRACKING=optional
# Optional application consent bridge for Kernel legacy identity adoption.
# Use an independent random key of at least 32 characters. Never enter it in chat.
# This does not isolate the existing unrestricted root execution tools.
MCP_OPERATOR_APPROVAL_ENABLED=false
MCP_OPERATOR_APPROVAL_KEY=
MCP_OPERATOR_APPROVAL_TTL_SECONDS=600
MCP_CONTINUITY_MAX_SNAPSHOT_BYTES=8388608
MCP_CONTINUITY_MAX_TOTAL_BYTES=268435456
MCP_CONTINUITY_CHECKPOINT_MAX_BYTES=32768
MCP_CONTINUITY_CONTEXT_MAX_BYTES=65536
MCP_CONTINUITY_SNAPSHOT_MAX_FILES=200
MCP_CONTINUITY_SNAPSHOT_MAX_BYTES=16777216
MCP_CONTINUITY_SNAPSHOT_MAX_DURATION_MS=2000

MCP_USAGE_LOG_MAX_BYTES=10485760
MCP_USAGE_LOG_FILES=7
MCP_USAGE_CONSOLE_LOG=false
MCP_PROBE_CWD=/opt/chatgpt-remote-mcp
# Optional executable in a mounted folder; empty disables the helper link.
MCP_COMMIT_HELPER_TARGET=

# Independent random secret generated by scripts/setup-keys.ps1.
MCP_PROBE_SECRET=
