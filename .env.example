# Copy to .env and replace placeholders. Never commit actual local settings.
SHARED_PATH=C:/path/to/workspace
WORKSPACE_ALIAS=/workspace
HOST_USER_HOME=C:/Users/your-username
HOST_HOME_ALIAS=/host/home
HOST_HOME_SECONDARY_ALIAS=/host/user
CODEX_PROFILE_PATH=C:/path/to/codex-profile
CODEX_PROFILE_TARGET=/opt/agent-profiles/codex
KERNEL_PROFILE_PATH=C:/path/to/kernel-profile
KERNEL_PROFILE_TARGET=/opt/agent-profiles/kernel

# Public endpoint and secrets
MCP_PUBLIC_URL=https://mcp.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token
MCP_OAUTH_ENABLED=true
MCP_OAUTH_APPROVAL_KEY=replace-with-a-random-secret
MCP_AUTH_TOKEN=
MCP_ALLOWED_HOSTS=
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Example names. For migrations, keep the existing volume names in .env.
COMPOSE_PROJECT_NAME=remote-mcp
MCP_CONTAINER_NAME=mcp-server
MCP_HOSTNAME=mcp-server
CLOUDFLARED_CONTAINER_NAME=mcp-tunnel
WORKMACHINE_IMAGE=chatgpt-remote-mcp:local
MCP_STATE_VOLUME=remote-mcp-state
MCP_STATE_DIR=/var/lib/chatgpt-remote-mcp
MCP_USAGE_VOLUME=remote-mcp-usage
MCP_HOME_VOLUME=remote-mcp-home
TZ=UTC

MCP_USAGE_LOG_MAX_BYTES=10485760
MCP_USAGE_LOG_FILES=7
MCP_PROBE_CWD=/opt/chatgpt-remote-mcp
# Optional executable in a mounted folder; empty disables the helper link.
MCP_COMMIT_HELPER_TARGET=
